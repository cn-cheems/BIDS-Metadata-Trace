----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/json",
}
----

///|
async fn numeric_cli(controls : Array[String], expected : Int32) -> String {
  let result = @shell.Cmd("moon", ["run", "cmd/main", "--"] + controls).output()
  guard result.exit_code() == expected else {
    fail(
      "Numeric CLI workflow failed: " +
      controls.join(" ") +
      "\n" +
      result.stdout() +
      result.stderr(),
    )
  }
  result.stdout()
}

///|
async fn numeric_cleanup(root : String) -> Unit {
  if !@fs.exists(root) {
    return
  }
  let absolute = @fs.realpath(root)
  guard absolute
    .replace_all(old="\\", new="/")
    .split("/")
    .last()
    .unwrap()
    .has_prefix("bids-trace-numeric.") else {
    fail("Refusing numeric cleanup outside dedicated temporary directory")
  }
  @fs.rmdir(absolute, recursive=true)
}

///|
async fn main {
  let base = "examples/ds000001/manifest.json"
  let changed = "examples/ds000001/changed-manifest.json"
  // Frozen full reports generated by executing commit ae5ba80, not snapshots
  // regenerated from the implementation under test.
  for
    (name, controls) in [
      (
        "legacy-expect.json",
        ["expect", base, "examples/expectations/acquisition.json"],
      ),
      (
        "legacy-filter.json",
        ["filter", base, "examples/selection/metadata-query.json"],
      ),
      (
        "legacy-acquisition.json",
        ["acquisition", base, "examples/expectations/scoped-acquisition.json"],
      ),
    ] {
    let output = numeric_cli(controls, 0)
    guard output == @fs.read_file("examples/numeric/" + name).text() else {
      fail("Legacy full output changed relative to ae5ba80: " + name)
    }
  }
  for
    (command, config) in [
      ("expect", "expectations.json"),
      ("acquisition", "acquisition.json"),
    ] {
    let passing = numeric_cli([command, base, "examples/numeric/" + config], 0)
    guard @json.parse(passing)
      is { "decision": String("pass"), "violation_count": Number(0.0, ..), .. } else {
      fail("Real RT 2.0 must pass the authored numeric project policy")
    }
    let failed = numeric_cli(
      [command, changed, "examples/numeric/" + config],
      1,
    )
    guard @json.parse(failed)
      is {
        "decision": String("violations"),
        "violation_count": Number(3.0, ..),
        ..
      } &&
      failed.contains("above_maximum") else {
      fail("Synthetic RT 3.0 must fail strict upper bound once per scan")
    }
  }
  for (manifest, matches) in [(base, 3.0), (changed, 0.0)] {
    let output = numeric_cli(
      ["filter", manifest, "examples/numeric/query.json"],
      0,
    )
    guard @json.parse(output)
      is {
        "matched_count": Number(count, ..),
        "error_count": Number(0.0, ..),
        ..
      } &&
      count == matches else {
      fail("Numeric selection failed mathematical equality or scope accounting")
    }
  }
  let p = "sub-01/func/sub-01_task-balloonanalogrisktask_run-01_bold.nii.gz"
  let retained = numeric_cli(
    ["filter", base, "examples/numeric/query.json", p, "absent", p],
    1,
  )
  guard @json.parse(retained)
    is { "matched_count": Number(2.0, ..), "error_count": Number(1.0, ..), .. } else {
    fail("Numeric filtering discarded duplicates or unresolved evidence")
  }
  let root = @fs.tmpdir(prefix="bids-trace-numeric")
  errdefer numeric_cleanup(root)
  let manifest = root + "/candidate.json"
  let source = "task-balloonanalogrisktask_bold.json"
  for
    (patch, exit_code, expected) in [
      ("synthetic-patch.json", 0, 0.0),
      ("invalid-patch.json", 1, 6.0),
    ] {
    let proposed = numeric_cli(
      ["plan", base, source, "examples/numeric/" + patch, "--manifest-only"],
      0,
    )
    @fs.write_file(manifest, proposed)
    let output = numeric_cli(
      ["expect", manifest, "examples/numeric/array-relation.json"],
      exit_code,
    )
    guard @json.parse(output) is { "violation_count": Number(count, ..), .. } &&
      count == expected else {
      fail("Array/relation workflow lost a failed field or relation check")
    }
    if exit_code == 1 {
      guard output.contains("not_strictly_increasing") &&
        output.contains("\"item_index\":1") &&
        output.contains("relation_failed") &&
        output.contains("[0.02,0.02,null]") else {
        fail(
          "Array diagnostics must retain the exact full input, first bad index and both relation operands",
        )
      }
    }
    guard proposed.contains("\"TaskName\":\"balloon analog risk task\"") else {
      fail("Synthetic augmentation discarded real metadata")
    }
  }
  let bad_config = root + "/bad-rules.json"
  @fs.write_file(
    bad_config, "{\"required\":[],\"allowed\":{},\"numeric\":{\"fields\":{\"RepetitionTime\":{\"type\":\"number\",\"unsupported\":1}},\"relations\":[]}}",
  )
  let invalid = @shell.Cmd("moon", [
    "run", "cmd/main", "--", "expect", base, bad_config,
  ]).output()
  guard invalid.exit_code() == 1 &&
    invalid.stdout().is_empty() &&
    @json.parse(invalid.stderr())
    is { "code": String("unknown_numeric_field_control"), .. } else {
    fail(
      "Unsupported numeric configuration must produce no partial success report",
    )
  }
  // Retry a valid policy after a failed operation in the same workflow.
  ignore(numeric_cli(["expect", base, "examples/numeric/expectations.json"], 0))
  numeric_cleanup(root)
  println(
    "Verified exact numeric policy, selection, acquisition, array/relations and byte-identical legacy reports.",
  )
}
