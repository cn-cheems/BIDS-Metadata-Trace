///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async/shell",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn clean_review_directory(root : String) -> Unit {
  let absolute = @fs.realpath(root)
  let normalized = absolute.replace_all(old="\\", new="/")
  guard normalized.split("/").last().unwrap().has_prefix("bids-trace-review.") else {
    fail("Refusing cleanup outside the dedicated review test directory.")
  }
  @fs.rmdir(absolute, recursive=true)
}

///|
async fn main {
  let env : Map[String, String] = Map([])
  // Optional portable compiler; never change the machine's global PATH.
  if @env.get_env_var("BIDS_TRACE_CC") is Some(compiler) {
    env["MOON_CC"] = compiler
  }
  if !@env.args().contains("--e2e-only") {
    @shell.Cmd("moon", ["fmt"], env~).run()
    @shell.Cmd("moon", ["fmt", "scripts/verify.mbtx"], env~).run()
    @shell.Cmd("moon", ["info", "--target", "all"], env~).run()
    @shell.Cmd("moon", ["check", "--target", "all", "--deny-warn"], env~).run()
    for target in ["wasm", "wasm-gc", "js", "native"] {
      @shell.Cmd("moon", ["test", "--target", target, "--deny-warn"], env~).run()
    }
  }
  let path = "sub-01/func/sub-01_task-balloonanalogrisktask_run-01_bold.nii.gz"
  let output = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "resolve", "examples/ds000001/manifest.json",
      path,
    ],
    env~,
  ).output()
  output.check()
  guard @json.parse(output.stdout())
    is {
      "data_path": String(actual),
      "metadata": { "RepetitionTime": Number(2.0, ..), .. },
      "fields": {
        "RepetitionTime": Array([{ "path": String(source), .. }]),
        ..
      },
      ..
    } &&
    actual == path &&
    source == "task-balloonanalogrisktask_bold.json" else {
    fail(
      "Real-data CLI report did not match the independently recorded fixture.",
    )
  }
  let batch = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "audit", "examples/ds000001/manifest.json",
    ],
    env~,
  ).output()
  batch.check()
  guard @json.parse(batch.stdout())
    is { "error_count": Number(0.0, ..), "entries": Array(entries), .. } &&
    entries.length() == 3 else {
    fail("Real-data audit must cover all three scans.")
  }
  let recovered = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "audit", "examples/ds000001/manifest.json",
      "absent", path,
    ],
    env~,
  ).output()
  guard recovered.exit_code() != 0 &&
    @json.parse(recovered.stdout())
    is {
      "error_count": Number(1.0, ..),
      "entries": Array(
        [
          { "status": String("error"), .. },
          { "status": String("resolved"), .. },
        ]
      ),
      ..
    } else {
    fail("Audit must report a failed query then a successful one.")
  }
  let compared = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "diff", "examples/ds000001/manifest.json",
      "examples/ds000001/changed-manifest.json",
    ],
    env~,
  ).output()
  compared.check()
  guard @json.parse(compared.stdout())
    is {
      "changed_count": Number(3.0, ..),
      "error_count": Number(0.0, ..),
      "entries": Array(impacts),
      ..
    } &&
    impacts.length() == 3 else {
    fail("The synthetic root edit must impact all three real scan paths.")
  }
  for impact in impacts {
    guard impact
      is {
        "kind": String("changed"),
        "changes": Array(
          [
            {
              "field": String("RepetitionTime"),
              "kind": String("value_changed"),
              "before": Number(2.0, ..),
              "after": Number(3.0, ..),
              ..
            },
          ]
        ),
        ..
      } else {
      fail("Each scan must show exactly the repetition-time change.")
    }
  }
  let fixture = "examples/ds000001/manifest.json"
  let changed = "examples/ds000001/changed-manifest.json"
  let provenance = "examples/ds000001/provenance-manifest.json"
  let ambiguous = "examples/release-check/ambiguous-manifest.json"
  for
    (before, after, options, expected_exit, decision, affected, unresolved) in [
      (fixture, fixture, [], 0, "pass", 0, 0),
      (fixture, changed, [], 1, "changes_detected", 3, 0),
      (fixture, changed, ["--effective-only"], 1, "changes_detected", 3, 0),
      (fixture, provenance, [], 1, "changes_detected", 1, 0),
      (fixture, provenance, ["--effective-only"], 0, "pass", 0, 0),
      (ambiguous, ambiguous, [], 1, "indeterminate", 0, 1),
      (ambiguous, ambiguous, ["--effective-only"], 1, "indeterminate", 0, 1),
    ] {
    let args = [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "check", before,
      after,
    ]
    args.append(options)
    let output = @shell.Cmd("moon", args, env~).output()
    guard output.exit_code() == expected_exit &&
      @json.parse(output.stdout())
      is {
        "decision": String(actual),
        "affected_paths": Array(affected_paths),
        "unresolved_paths": Array(unresolved_paths),
        "impact": { "entries": Array(_), .. },
        ..
      } &&
      actual == decision &&
      affected_paths.length() == affected &&
      unresolved_paths.length() == unresolved else {
      fail(
        "Release check exit, decision or retained path evidence is incorrect.",
      )
    }
  }
  let missing = "examples/release-check/does-not-exist.json"
  let input_error = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "check", fixture,
      missing,
    ],
    env~,
  ).output()
  guard input_error.exit_code() == 1 &&
    input_error.stdout().is_empty() &&
    @json.parse(input_error.stderr())
    is { "code": String("io_error"), "path": String(actual), .. } &&
    actual == missing else {
    fail(
      "Missing snapshot must fail with its actual IO path, not an empty successful report.",
    )
  }
  let usage_error = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "check", fixture,
      fixture, "--unknown",
    ],
    env~,
  ).output()
  guard usage_error.exit_code() == 1 &&
    usage_error.stdout().is_empty() &&
    usage_error.stderr().contains("Usage:") else {
    fail("Unsupported release policy option must fail explicitly.")
  }
  @shell.Cmd("git", ["diff", "--check"]).run()
  let discovery = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "discover", "examples/ds000001/tree",
    ],
    env~,
  ).output()
  discovery.check()
  guard @json.parse(discovery.stdout())
    is {
      "status": String("complete_supported_inventory"),
      "manifest": {
        "files": Array(found),
        "sidecars": Array(
          [{ "metadata": { "RepetitionTime": Number(2.0, ..), .. }, .. }]
        ),
        ..
      },
      "auxiliary_paths": Array([String("README")]),
      "excluded_paths": Array([]),
      ..
    } &&
    found.length() == 3 else {
    fail("Discovery must retain all three real fixture paths and metadata.")
  }
  let exported = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "discover", "examples/ds000001/tree",
      "--manifest-only",
    ],
    env~,
  ).output()
  exported.check()
  guard @json.parse(exported.stdout())
    is { "files": Array(exported_paths), "sidecars": Array([_]), .. } &&
    exported_paths.length() == 3 &&
    exported.stdout().contains("2.0") else {
    fail("The discovered manifest must preserve numeric tokens.")
  }
  let plan_args = [
    "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "plan", fixture,
    "task-balloonanalogrisktask_bold.json", "examples/edit-plan/change-repetition-time.json",
  ]
  let planned = @shell.Cmd("moon", plan_args, env~).output()
  planned.check()
  guard @json.parse(planned.stdout())
    is {
      "before_sidecar": { "RepetitionTime": Number(2.0, ..), .. },
      "after_sidecar": {
        "RepetitionTime": Number(3.0, ..),
        "TaskName": String("balloon analog risk task"),
        ..
      },
      "before_manifest": Object(_),
      "after_manifest": Object(_),
      "impact": {
        "changed_count": Number(3.0, ..),
        "error_count": Number(0.0, ..),
        ..
      },
      ..
    } else {
    fail(
      "Edit planning must retain both snapshots, untouched TaskName and three affected scans.",
    )
  }
  let plan_export_args = plan_args.copy()
  plan_export_args.push("--manifest-only")
  let candidate = @shell.Cmd("moon", plan_export_args, env~).output()
  candidate.check()
  guard @json.parse(candidate.stdout())
    is {
      "files": Array(candidate_paths),
      "sidecars": Array(
        [{ "metadata": { "RepetitionTime": Number(3.0, ..), .. }, .. }]
      ),
      ..
    } &&
    candidate_paths.length() == 3 &&
    candidate.stdout().contains("3.0") else {
    fail(
      "The planned snapshot must remain reloadable with exact number tokens.",
    )
  }
  let missing_patch = "examples/edit-plan/does-not-exist.json"
  let failed_plan = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "plan", fixture,
      "task-balloonanalogrisktask_bold.json", missing_patch,
    ],
    env~,
  ).output()
  guard failed_plan.exit_code() == 1 &&
    failed_plan.stdout().is_empty() &&
    @json.parse(failed_plan.stderr())
    is { "code": String("io_error"), "path": String(actual_patch), .. } &&
    actual_patch == missing_patch else {
    fail("Patch IO failures must identify the actual patch file.")
  }
  let unresolved_plan = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "plan", ambiguous,
      "bold.json", "examples/edit-plan/change-repetition-time.json",
    ],
    env~,
  ).output()
  guard unresolved_plan.exit_code() == 1 &&
    @json.parse(unresolved_plan.stdout())
    is {
      "after_manifest": Object(_),
      "impact": {
        "error_count": Number(1.0, ..),
        "entries": Array([{ "kind": String("unresolved"), .. }]),
        ..
      },
      ..
    } else {
    fail(
      "An indeterminate plan must retain the complete candidate and impact, and fail the process.",
    )
  }
  let review_dir = @fs.tmpdir(prefix="bids-trace-review")
  errdefer clean_review_directory(review_dir)
  for
    (before, after, options, decision) in [
      (fixture, changed, [], "changes_detected"),
      (fixture, provenance, ["--effective-only"], "pass"),
      (ambiguous, ambiguous, [], "indeterminate"),
    ] {
    let bundle_args = [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "bundle", before,
      after,
    ]
    bundle_args.append(options)
    let captured = @shell.Cmd("moon", bundle_args, env~).output()
    captured.check()
    guard @json.parse(captured.stdout())
      is {
        "version": Number(1.0, ..),
        "before": Object(_),
        "after": Object(_),
        "expected": { "decision": String(actual), "impact": Object(_), .. },
        ..
      } &&
      actual == decision else {
      fail("Review capture must retain inputs and the complete decision.")
    }
    let bundle_path = review_dir + "/review.json"
    @fs.write_file(bundle_path, captured.stdout())
    let replayed = @shell.Cmd(
      "moon",
      [
        "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "replay", bundle_path,
      ],
      env~,
    ).output()
    replayed.check()
    guard @json.parse(replayed.stdout())
      is { "decision": String(actual), "impact": Object(_), .. } &&
      actual == decision else {
      fail(
        "Verified reproduction must keep the release decision, including indeterminate.",
      )
    }
    if decision == "changes_detected" {
      @fs.write_file(
        bundle_path,
        captured
        .stdout()
        .replace(
          old="\"decision\":\"changes_detected\"",
          new="\"decision\":\"pass\"",
        ),
      )
      let stale = @shell.Cmd(
        "moon",
        [
          "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "replay", bundle_path,
        ],
        env~,
      ).output()
      guard stale.exit_code() == 1 &&
        stale.stdout().is_empty() &&
        @json.parse(stale.stderr()) is { "code": String("replay_mismatch"), .. } else {
        fail("A modified expected decision must reject replay explicitly.")
      }
    }
  }
  clean_review_directory(review_dir)
  verify_batch_workflow(env)
  verify_source_coverage(env)
  verify_field_summary(env)
  verify_review_csv(env)
  verify_source_changes(env)
  verify_expectations(env)
  verify_scan_selection(env)
  println("Verified core targets and real-data Wasm CLI.")
}

///|
async fn verify_batch_workflow(env : Map[String, String]) -> Unit {
  let baseline = "examples/ds000001/provenance-manifest.json"
  let batch = "examples/edit-plan/coordinated-edits.json"
  let args = [
    "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "plan-batch", baseline,
    batch,
  ]
  let output = @shell.Cmd("moon", args, env~).output()
  output.check()
  guard @json.parse(output.stdout())
    is {
      "sidecars": Array(
        [
          { "after_sidecar": Object(local_values), .. },
          {
            "after_sidecar": {
              "RepetitionTime": Number(3.0, ..),
              "TaskName": String("balloon analog risk task"),
              ..
            },
            ..
          },
        ]
      ),
      "before_manifest": Object(_),
      "after_manifest": Object(_),
      "impact": {
        "changed_count": Number(3.0, ..),
        "error_count": Number(0.0, ..),
        ..
      },
      ..
    } &&
    local_values.length() == 0 else {
    fail(
      "Coordinated edit must retain full evidence and expose the new root value for all three real scan paths.",
    )
  }
  let root = @fs.tmpdir(prefix="bids-trace-review")
  errdefer clean_review_directory(root)
  let candidate_path = root + "/candidate.json"
  let export_args = args.copy()
  export_args.push("--manifest-only")
  let exported = @shell.Cmd("moon", export_args, env~).output()
  exported.check()
  @fs.write_file(candidate_path, exported.stdout())
  let path = "sub-01/func/sub-01_task-balloonanalogrisktask_run-01_bold.nii.gz"
  let resolved = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "resolve", candidate_path,
      path,
    ],
    env~,
  ).output()
  resolved.check()
  guard @json.parse(resolved.stdout())
    is {
      "metadata": { "RepetitionTime": Number(3.0, ..), .. },
      "fields": {
        "RepetitionTime": Array(
          [{ "path": String("task-balloonanalogrisktask_bold.json"), .. }]
        ),
        ..
      },
      ..
    } else {
    fail(
      "Exported batch candidate must resolve the removed local override from its edited root.",
    )
  }
  let captured = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "bundle", baseline,
      candidate_path,
    ],
    env~,
  ).output()
  captured.check()
  let bundle_path = root + "/bundle.json"
  @fs.write_file(bundle_path, captured.stdout())
  let replayed = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "replay", bundle_path,
    ],
    env~,
  ).output()
  replayed.check()
  guard @json.parse(replayed.stdout())
    is {
      "decision": String("changes_detected"),
      "affected_paths": Array(affected),
      ..
    } &&
    affected.length() == 3 else {
    fail("Batch candidates must feed the existing offline review workflow.")
  }
  let bad_batch = root + "/bad.json"
  @fs.write_file(
    bad_batch, "{\"edits\":[{\"path\":\"task-balloonanalogrisktask_bold.json\",\"set\":{\"RepetitionTime\":4.0},\"remove\":[\"absent\"]}]}",
  )
  let rejected = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "plan-batch", baseline,
      bad_batch,
    ],
    env~,
  ).output()
  guard rejected.exit_code() == 1 &&
    rejected.stdout().is_empty() &&
    @json.parse(rejected.stderr())
    is { "code": String("missing_metadata_field"), .. } else {
    fail("An invalid batch must never emit a partial plan.")
  }
  let missing = root + "/missing.json"
  let missing_result = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "plan-batch", baseline,
      missing,
    ],
    env~,
  ).output()
  guard missing_result.exit_code() == 1 &&
    missing_result.stdout().is_empty() &&
    @json.parse(missing_result.stderr())
    is { "code": String("io_error"), "path": String(actual), .. } &&
    actual == missing else {
    fail("Batch IO failure must identify the actual file.")
  }
  @fs.write_file(bad_batch, "{\"edits\":[]}")
  let indeterminate = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "plan-batch", "examples/release-check/ambiguous-manifest.json",
      bad_batch,
    ],
    env~,
  ).output()
  guard indeterminate.exit_code() == 1 &&
    @json.parse(indeterminate.stdout())
    is {
      "after_manifest": Object(_),
      "impact": { "error_count": Number(1.0, ..), .. },
      ..
    } else {
    fail(
      "An empty batch must retain existing ambiguity rather than turn it into approval.",
    )
  }
  clean_review_directory(root)
}

///|
async fn verify_source_coverage(env : Map[String, String]) -> Unit {
  let output = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "sources", "examples/ds000001/provenance-manifest.json",
    ],
    env~,
  ).output()
  output.check()
  guard @json.parse(output.stdout())
    is {
      "scope": String("indexed_scans"),
      "scan_count": Number(3.0, ..),
      "error_count": Number(0.0, ..),
      "entries": Array(
        [
          { "winning_paths": Array([_]), .. },
          {
            "winning_paths": Array(winners),
            "fully_shadowed_paths": Array([]),
            ..
          },
        ]
      ),
      ..
    } &&
    winners.length() == 3 else {
    fail(
      "Source coverage must retain the partially shadowed root and local source across three real scans.",
    )
  }
  let bad = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "sources", "examples/release-check/ambiguous-manifest.json",
    ],
    env~,
  ).output()
  guard bad.exit_code() == 1 &&
    @json.parse(bad.stdout())
    is {
      "error_count": Number(1.0, ..),
      "diagnostics": Array([{ "code": String("ambiguous_inheritance"), .. }]),
      "entries": Array(
        [{ "winning_paths": Array([]), .. }, { "winning_paths": Array([]), .. }]
      ),
      ..
    } else {
    fail(
      "Ambiguous coverage must retain both sources without a guessed winner.",
    )
  }
}

///|
async fn verify_field_summary(env : Map[String, String]) -> Unit {
  let output = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "summarize", "examples/ds000001/provenance-manifest.json",
      "RepetitionTime", "MissingField",
    ],
    env~,
  ).output()
  output.check()
  guard @json.parse(output.stdout())
    is {
      "error_count": Number(0.0, ..),
      "query_count": Number(3.0, ..),
      "fields": Array(
        [
          { "groups": Array([{ "observations": Array(observations), .. }]), .. },
          { "missing": Array(missing), "groups": Array([]), .. },
        ]
      ),
      ..
    } &&
    observations.length() == 3 &&
    missing.length() == 3 else {
    fail("Real cohort summary lost observations or missing fields")
  }
  let bad = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "summarize", "examples/release-check/ambiguous-manifest.json",
      "RepetitionTime",
    ],
    env~,
  ).output()
  guard bad.exit_code() == 1 &&
    @json.parse(bad.stdout())
    is {
      "error_count": Number(1.0, ..),
      "fields": Array([{ "missing": Array([]), "groups": Array([]), .. }]),
      ..
    } else {
    fail("Unresolved cohort became missing metadata")
  }
}

///|
async fn verify_review_csv(env : Map[String, String]) -> Unit {
  let output = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "table", "examples/ds000001/provenance-manifest.json",
      "RepetitionTime", "MissingField",
    ],
    env~,
  ).output()
  output.check()
  let csv = output.stdout()
  guard csv.has_prefix(
      "\"query_index\",\"data_path\",\"status\",\"diagnostic\",",
    ) &&
    csv.split("\r\n").length() == 5 &&
    csv.contains("\"true\",\"json:2.0\"") &&
    csv.contains("\"false\",\"\",\"\",\"\"\r\n") &&
    csv.contains("sub-01_task-balloonanalogrisktask_run-03_bold.nii.gz") else {
    fail("CSV lost real scan rows exact values or missingness")
  }
  let bad = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "table", "examples/release-check/ambiguous-manifest.json",
      "RepetitionTime",
    ],
    env~,
  ).output()
  guard bad.exit_code() == 1 &&
    bad.stdout().contains("\"error\",\"json:{") &&
    bad.stdout().contains("ambiguous_inheritance") else {
    fail("CSV lost unresolved row or exit status")
  }
  let duplicate = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "table", "examples/ds000001/manifest.json",
      "x", "x",
    ],
    env~,
  ).output()
  guard duplicate.exit_code() == 1 &&
    duplicate.stdout().is_empty() &&
    duplicate.stderr().contains("duplicate_field_request") else {
    fail("Invalid CSV projection emitted partial stdout")
  }
}

///|
async fn verify_source_changes(env : Map[String, String]) -> Unit {
  let output = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "plan-sources",
      "examples/ds000001/manifest.json", "examples/edit-plan/rename-source.json",
    ],
    env~,
  ).output()
  output.check()
  guard @json.parse(output.stdout())
    is {
      "before_manifest": {
        "sidecars": Array(
          [{ "path": String("task-balloonanalogrisktask_bold.json"), .. }]
        ),
        ..
      },
      "after_manifest": {
        "sidecars": Array(
          [
            {
              "path": String("bold.json"),
              "metadata": { "RepetitionTime": Number(2.0, ..), .. },
              ..
            },
          ]
        ),
        ..
      },
      "impact": {
        "error_count": Number(0.0, ..),
        "changed_count": Number(3.0, ..),
        ..
      },
      ..
    } else {
    fail("Source rename lost real metadata or provenance impact")
  }
  let candidate = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "plan-sources",
      "examples/ds000001/manifest.json", "examples/edit-plan/rename-source.json",
      "--manifest-only",
    ],
    env~,
  ).output()
  candidate.check()
  let root = @fs.tmpdir(prefix="bids-trace-review")
  errdefer clean_review_directory(root)
  let path = root + "/renamed.json"
  @fs.write_file(path, candidate.stdout())
  let check = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "check", "examples/ds000001/manifest.json",
      path, "--effective-only",
    ],
    env~,
  ).output()
  check.check()
  guard @json.parse(check.stdout()) is { "decision": String("pass"), .. } else {
    fail("Source rename changed effective values")
  }
  let missing = @shell.Cmd(
    "moon",
    [
      "run",
      "cmd/main",
      "--target",
      "wasm",
      "--deny-warn",
      "--",
      "plan-sources",
      "examples/ds000001/manifest.json",
      root + "/absent.json",
    ],
    env~,
  ).output()
  guard missing.exit_code() == 1 &&
    missing.stdout().is_empty() &&
    missing.stderr().contains("io_error") else {
    fail("Source input IO failure emitted partial plan")
  }
  clean_review_directory(root)
}

///|
async fn verify_expectations(env : Map[String, String]) -> Unit {
  let rule = "examples/expectations/acquisition.json"
  let good = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "expect", "examples/ds000001/manifest.json",
      rule,
    ],
    env~,
  ).output()
  good.check()
  guard @json.parse(good.stdout())
    is {
      "decision": String("pass"),
      "violation_count": Number(0.0, ..),
      "entries": Array(entries),
      ..
    } &&
    entries.length() == 3 &&
    good.stdout().contains("\"actual\":2.0") else {
    fail(
      "Real acquisition expectations did not preserve exact values or all scans",
    )
  }
  let changed = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "expect", "examples/ds000001/changed-manifest.json",
      rule,
    ],
    env~,
  ).output()
  guard changed.exit_code() == 1 &&
    @json.parse(changed.stdout())
    is {
      "decision": String("violations"),
      "violation_count": Number(3.0, ..),
      "error_count": Number(0.0, ..),
      ..
    } &&
    changed.stdout().contains("\"actual\":3.0") else {
    fail(
      "Counterfactual acquisition violations lost evidence or process failure",
    )
  }
  let unknown = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "expect", "examples/ds000001/manifest.json",
      rule, "absent", "sub-01/func/sub-01_task-balloonanalogrisktask_run-01_bold.nii.gz",
    ],
    env~,
  ).output()
  guard unknown.exit_code() == 1 &&
    @json.parse(unknown.stdout())
    is {
      "decision": String("indeterminate"),
      "violation_count": Number(0.0, ..),
      "error_count": Number(1.0, ..),
      "entries": Array(
        [
          { "status": String("error"), .. },
          { "status": String("resolved"), .. },
        ]
      ),
      ..
    } else {
    fail("Expectation query failure did not recover for next scan")
  }
  let ambiguous = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "expect", "examples/release-check/ambiguous-manifest.json",
      rule,
    ],
    env~,
  ).output()
  guard ambiguous.exit_code() == 1 &&
    @json.parse(ambiguous.stdout())
    is {
      "decision": String("indeterminate"),
      "error_count": Number(1.0, ..),
      ..
    } else {
    fail("Ambiguous inheritance falsely passed expectations")
  }
  let root = @fs.tmpdir(prefix="bids-trace-review")
  errdefer clean_review_directory(root)
  @fs.write_file(root + "/empty.json", "{\"files\":[],\"sidecars\":[]}")
  let empty = @shell.Cmd(
    "moon",
    [
      "run",
      "cmd/main",
      "--target",
      "wasm",
      "--deny-warn",
      "--",
      "expect",
      root + "/empty.json",
      rule,
    ],
    env~,
  ).output()
  guard empty.exit_code() == 1 &&
    @json.parse(empty.stdout())
    is { "decision": String("indeterminate"), "empty_audit": True, .. } else {
    fail("Empty indexed cohort received vacuous approval")
  }
  @fs.write_file(
    root + "/invalid.json",
    "{\"required\":[],\"allowed\":{},\"tolerance\":0.1}",
  )
  let invalid = @shell.Cmd(
    "moon",
    [
      "run",
      "cmd/main",
      "--target",
      "wasm",
      "--deny-warn",
      "--",
      "expect",
      "examples/ds000001/manifest.json",
      root + "/invalid.json",
    ],
    env~,
  ).output()
  guard invalid.exit_code() == 1 &&
    invalid.stdout().is_empty() &&
    invalid.stderr().contains("unknown_expectation_field") else {
    fail(
      "Unknown expectation control silently ignored or partial report emitted",
    )
  }
  clean_review_directory(root)
}

///|
async fn verify_scan_selection(env : Map[String, String]) -> Unit {
  let query = "examples/selection/later-runs.json"
  let selection = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "select", "examples/ds000001/manifest.json",
      query,
    ],
    env~,
  ).output()
  selection.check()
  guard @json.parse(selection.stdout())
    is {
      "selected_count": Number(2.0, ..),
      "total_count": Number(3.0, ..),
      "selected_paths": Array([String(second), String(third)]),
      "excluded_paths": Array([String(first)]),
      "query": {
        "entities": { "run": Array([String("2"), String("3")]), .. },
        ..
      },
      ..
    } &&
    second.contains("run-02") &&
    third.contains("run-03") &&
    first.contains("run-01") else {
    fail(
      "Real cohort selection did not normalize decimal choices or account for every scan",
    )
  }
  let audit = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "select", "examples/ds000001/manifest.json",
      query, "--audit",
    ],
    env~,
  ).output()
  audit.check()
  guard @json.parse(audit.stdout())
    is {
      "audit": {
        "error_count": Number(0.0, ..),
        "entries": Array(
          [
            {
              "result": {
                "metadata": { "RepetitionTime": Number(2.0, ..), .. },
                "applied_sidecars": Array(
                  [String("task-balloonanalogrisktask_bold.json")]
                ),
                ..
              },
              ..
            },
            {
              "result": {
                "metadata": { "RepetitionTime": Number(2.0, ..), .. },
                ..
              },
              ..
            },
          ]
        ),
        ..
      },
      "selection": { "selected_count": Number(2.0, ..), .. },
      ..
    } &&
    audit.stdout().contains("\"RepetitionTime\":2.0") else {
    fail("Selected audit lost parent inheritance or exact metadata tokens")
  }
  let root = @fs.tmpdir(prefix="bids-trace-review")
  errdefer clean_review_directory(root)
  let broad = root + "/broad.json"
  @fs.write_file(broad, "{\"suffixes\":[\"bold\"],\"entities\":{}}")
  let ambiguous = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "select", "examples/release-check/ambiguous-manifest.json",
      broad, "--audit",
    ],
    env~,
  ).output()
  guard ambiguous.exit_code() == 1 &&
    @json.parse(ambiguous.stdout())
    is {
      "selection": { "selected_count": Number(1.0, ..), .. },
      "audit": { "error_count": Number(1.0, ..), .. },
      ..
    } &&
    ambiguous.stdout().contains("ambiguous_inheritance") else {
    fail("Selection silently filtered an ambiguous chosen scan")
  }
  let empty_query = root + "/empty.json"
  @fs.write_file(
    empty_query, "{\"suffixes\":[\"bold\"],\"entities\":{\"task\":[\"other\"]}}",
  )
  let empty = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "select", "examples/ds000001/manifest.json",
      empty_query, "--audit",
    ],
    env~,
  ).output()
  empty.check()
  guard @json.parse(empty.stdout())
    is {
      "selection": {
        "selected_count": Number(0.0, ..),
        "total_count": Number(3.0, ..),
        ..
      },
      "audit": { "entries": Array([]), .. },
      ..
    } else {
    fail("Empty selection fell back to the full dataset")
  }
  let invalid_query = root + "/invalid.json"
  @fs.write_file(
    invalid_query, "{\"suffixes\":[\"bold\"],\"entities\":{\"run\":[\"1\",\"01\"]}}",
  )
  let invalid = @shell.Cmd(
    "moon",
    [
      "run", "cmd/main", "--target", "wasm", "--deny-warn", "--", "select", "examples/ds000001/manifest.json",
      invalid_query,
    ],
    env~,
  ).output()
  guard invalid.exit_code() == 1 &&
    invalid.stdout().is_empty() &&
    invalid.stderr().contains("duplicate_query_choice") else {
    fail("Normalized duplicate query choices were silently accepted")
  }
  let missing = @shell.Cmd(
    "moon",
    [
      "run",
      "cmd/main",
      "--target",
      "wasm",
      "--deny-warn",
      "--",
      "select",
      "examples/ds000001/manifest.json",
      root + "/absent.json",
    ],
    env~,
  ).output()
  guard missing.exit_code() == 1 &&
    missing.stdout().is_empty() &&
    missing.stderr().contains("io_error") else {
    fail("Query IO error produced a partial selection")
  }
  clean_review_directory(root)
}
